{
  "name": "jev-test-auditor",
  "version": "0.1.1",
  "description": "A local-first semantic test quality auditor.",
  "author": "Juan Manuel Gomez Dagum <juanmanuelgomezomil@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/juanmaagd/jev-test-auditor.git"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills/jev-test-audit",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "report:example": "UPDATE_REPORT_EXAMPLE=1 vitest run test/html-report-example.test.ts",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.4",
    "eslint": "9.39.5",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  },
  "bin": {
    "jta": "dist/cli/index.js",
    "jev-test-auditor": "dist/cli/index.js"
  },
  "dependencies": {
    "typescript": "5.9.3"
  }
}
